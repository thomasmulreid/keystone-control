# Governance posture: observe | propose | act
# observe = read-only, no action controls render
# propose = compose + record the decision and payload, send nothing  (default)
# act     = approved actions are sent under scoped credentials
GOVERNANCE_MODE=propose

# commercetools — scope each client to the mutations its role may make.
# Never an admin key.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_AUTH_URL=
CTP_API_URL=

# Database (provisioned by: vercel integration add neon)
DATABASE_URL=
